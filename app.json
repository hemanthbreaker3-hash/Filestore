{
  "name": "Telegram File Share/Sharing Bot",
  "description": "file sharing bot store posts and it can access by special links",
  "keywords": [
    "telegram",
    "file",
    "sharing"
  ],
  "repository": "https://github.com/anizoneflix/Telegram-File-Store",
  "logo": "https://graph.org/file/6ceef6a98b82b0e0e2f03.jpg",
  "env": {
    "API_HASH": {
      "description": "Telegram API hash from my.telegram.org",
      "value": ""
    },
    "APP_ID": {
      "description": "Telegram API ID from my.telegram.org",
      "value": ""
    },
    "CHANNEL_ID": {
      "description": "Telegram database channel ID; add the bot as an administrator",
      "value": ""
    },
    "DATABASE_URL": {
      "description": "MongoDB connection URI",
      "value": ""
    },
    "DB_NAME": {
      "description": "MongoDB database name",
      "value": "Filestore"
    },
    "OWNER": {
      "description": "Telegram owner username without @",
      "value": ""
    },
    "OWNER_ID": {
      "description": "Numeric Telegram owner user ID",
      "value": ""
    },
    "PORT": {
      "description": "Web server port",
      "value": "8080"
    },
    "TG_BOT_TOKEN": {
      "description": "Telegram bot token from BotFather",
      "value": ""
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
