# The repository supports only these deployment environment variables.
# Put your own values here; never commit real credentials to GitHub.
API_HASH=your_api_hash
APP_ID=your_app_id
CHANNEL_ID=-100xxxxxxxxxx
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=Filestore
OWNER=your_telegram_username_without_at
OWNER_ID=your_numeric_telegram_user_id
PORT=8080
TG_BOT_TOKEN=your_bot_token
